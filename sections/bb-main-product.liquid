{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'bb-product-form-' | append: section.id
  assign current_image_alt = current_variant.featured_image.alt | default: product.featured_image.alt | default: product.title
  capture current_image
    render 'bb-variant-image', product: product, variant: current_variant
  endcapture
  capture current_background
    render 'bb-variant-theme', product: product, variant: current_variant, mode: 'background'
  endcapture
  capture current_panel
    render 'bb-variant-theme', product: product, variant: current_variant, mode: 'panel'
  endcapture
  assign product_headline = product.metafields.custom.headline.value
  assign product_description = product.description
  assign default_highlights = ''

  case product.handle
    when 'bow-tote'
      assign fallback_headline = 'A little bow. A lot of personality.'
      assign fallback_description = 'Your everyday carry, with a playful finishing touch. Long shoulder handles and statement side bows make this tote an easy addition to your daily rotation.'
      assign default_highlights = 'Statement bow details at the sides|Long handles for shoulder carrying|A softly structured everyday silhouette'
    when 'foldaway-tote'
      assign fallback_headline = 'Big on the day. Small on the go.'
      assign fallback_description = 'An extra bag, always within reach. This roomy shoulder tote folds into a compact matching pouch with a clip, ready to come along for errands, shopping and spontaneous plans.'
      assign default_highlights = 'Folds into a compact matching pouch|Clip detail for keeping it close|A relaxed shoulder bag silhouette'
    when 'travel-weekender'
      assign fallback_headline = 'Your next getaway starts here.'
      assign fallback_description = 'For a change of scene and everything you want to bring. A statement travel bag with carry handles, a shoulder strap and zip details, in a colour for every kind of getaway.'
      assign default_highlights = 'Twin carry handles and a shoulder strap|Zip details with gold-tone hardware|An elongated travel bag silhouette'
  endcase

  if product_headline == blank
    assign product_headline = fallback_headline
  endif
  if product_description == blank
    assign product_description = fallback_description
  endif
  assign product_index = 1
  case product.handle
    when 'foldaway-tote'
      assign product_index = 2
    when 'travel-weekender'
      assign product_index = 3
  endcase

  # Extra photos (any image that is not a colour's main photo) are placed
  # around the page by their alt text:
  #   "dimension" / "size" / "measure"              -> size guide beside the FAQ
  #   "worn" / "carried" / "lifestyle" / "styled"   -> "Carry it your way" band
  #   anything else                                 -> "A closer look" section
  # Lists are comma-wrapped ids (",123,456,") so `contains` matches whole ids.
  assign variant_media_ids = ','
  for variant in product.variants
    if variant.featured_media
      assign variant_media_ids = variant_media_ids | append: variant.featured_media.id | append: ','
    endif
  endfor

  assign lifestyle_media_ids = ','
  assign detail_media_ids = ','
  assign size_media_ids = ','
  for media in product.media
    if media.media_type != 'image'
      continue
    endif
    assign media_key = ',' | append: media.id | append: ','
    if variant_media_ids contains media_key
      continue
    endif
    assign media_alt = media.alt | downcase
    if media_alt contains 'dimension' or media_alt contains 'size' or media_alt contains 'measure'
      assign size_media_ids = size_media_ids | append: media.id | append: ','
    elsif media_alt contains 'worn' or media_alt contains 'carried' or media_alt contains 'lifestyle' or media_alt contains 'styled'
      assign lifestyle_media_ids = lifestyle_media_ids | append: media.id | append: ','
    else
      assign detail_media_ids = detail_media_ids | append: media.id | append: ','
    endif
  endfor
-%}

<section
  class="bb-product"
  data-bb-product
  style="--bb-product-bg: {{ current_background | strip | default: section.settings.background_color }}; --bb-product-panel: {{ current_panel | strip | default: section.settings.panel_color }};"
>
  <div class="bb-product__shipping">
    <span aria-hidden="true">♧</span>
    {{ section.settings.shipping_message | escape }}
  </div>
  <div class="bb-product__topbar">
    <a href="{{ routes.root_url }}" class="bb-product__back" aria-label="Back to collection">
      <span aria-hidden="true">←</span>
      <span class="bb-product__back-label">Back to collection</span>
    </a>
    <a href="{{ routes.root_url }}" class="bb-product__brand">{{ section.settings.brand_name | escape }}</a>
    <a href="{{ routes.cart_url }}" class="bb-product__cart" aria-label="{{ 'templates.cart.cart' | t }} ({{ cart.item_count }})">
      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="bb-product__cart-label">Bag</span>
      <span class="bb-product__cart-count" data-bb-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>

  <div class="bb-product__navigation" aria-label="In this page">
    <a href="#bb-product-description">The details</a>
    <a href="#bb-product-colours">Choose your colour</a>
    <a href="#bb-product-related">More bags</a>
  </div>

  <div class="bb-product__layout" id="bb-product-detail">
    <div class="bb-product__gallery" data-bb-gallery>
      <div class="bb-product__photo">
        <span class="bb-product__photo-label">✧ YOUR EVERYDAY PLUS ONE.</span>
        {%- if current_image != blank -%}
          <img
            src="{{ current_image | strip | escape }}"
            alt="{{ current_image_alt | escape }}"
            width="1200"
            height="1200"
            data-bb-product-image
            fetchpriority="high"
          >
        {%- else -%}
          <div class="bb-product__no-image">Add product photos in Shopify to show this bag.</div>
        {%- endif -%}
        <button type="button" class="bb-product__zoom" data-bb-zoom aria-label="View product image larger">⌕</button>
        <div class="bb-product__photo-caption">
          <span data-bb-photo-color>{{ current_variant.title | escape | upcase }}</span>
          <span>0{{ product_index }} / 03</span>
        </div>
      </div>
      {%- if product.variants.size > 1 -%}
        <div class="bb-product__thumbnails" aria-label="Product images">
          {%- for variant in product.variants -%}
            {%- capture variant_image -%}{%- render 'bb-variant-image', product: product, variant: variant -%}{%- endcapture -%}
            <button
              type="button"
              data-bb-gallery-variant="{{ variant.id }}"
              aria-label="Show {{ variant.title | escape }} photo"
              {% if variant.id == current_variant.id %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}
            >
              {%- if variant_image != blank -%}
                <img src="{{ variant_image | strip | escape }}" alt="{{ variant.title | escape }}" width="180" height="180" loading="lazy">
              {%- endif -%}
              <span>{{ variant.title | escape }}</span>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <dialog class="bb-product__zoom-dialog" data-bb-zoom-dialog aria-label="Product image">
        <button type="button" data-bb-close-zoom aria-label="Close image">×</button>
        <img
          src="{{ current_image | strip | escape }}"
          alt="{{ current_image_alt | escape }}"
          width="1200"
          height="1200"
          data-bb-zoom-image
        >
      </dialog>
    </div>

    <div class="bb-product__details">
      <p class="bb-product__eyebrow">{{ section.settings.eyebrow | escape }} / 0{{ product_index }}</p>
      <h1>{{ product.title | escape }}</h1>
      <p class="bb-product__headline">{{ product_headline | escape }}</p>
      <div class="bb-product__description rte" id="bb-product-description">
        {%- if product_description != blank -%}
          {{ product_description }}
        {%- else -%}
          <p>Choose your colour and make this carry style yours.</p>
        {%- endif -%}
      </div>
      <div class="bb-product__price" role="status" aria-live="polite">
        <span data-bb-price>{{ current_variant.price | money }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s data-bb-compare-price>{{ current_variant.compare_at_price | money }}</s>
        {%- else -%}
          <s data-bb-compare-price hidden></s>
        {%- endif -%}
      </div>

      {% form 'product', product, id: product_form_id, class: 'bb-product__form', data-type: 'add-to-cart-form' %}
        {%- if form.errors -%}
          <div class="bb-product__errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        {%- if product.variants.size > 1 -%}
          <fieldset class="bb-product__variants" id="bb-product-colours">
            <legend>Colour <strong data-bb-selected-color>{{ current_variant.title | escape }}</strong></legend>
            <div class="bb-product__swatches">
              {%- for variant in product.variants -%}
                {%- capture variant_image -%}{%- render 'bb-variant-image', product: product, variant: variant -%}{%- endcapture -%}
                {%- capture swatch_color -%}{%- render 'bb-swatch-color', variant: variant -%}{%- endcapture -%}
                {%- capture variant_background -%}{%- render 'bb-variant-theme', product: product, variant: variant, mode: 'background' -%}{%- endcapture -%}
                {%- capture variant_panel -%}{%- render 'bb-variant-theme', product: product, variant: variant, mode: 'panel' -%}{%- endcapture -%}
                <input
                  type="radio"
                  name="id"
                  id="bb-variant-{{ section.id }}-{{ variant.id }}"
                  value="{{ variant.id }}"
                  data-bb-variant
                  data-variant-title="{{ variant.title | escape }}"
                  data-image="{{ variant_image | strip | escape }}"
                  data-background="{{ variant_background | strip | default: section.settings.background_color }}"
                  data-panel="{{ variant_panel | strip | default: section.settings.panel_color }}"
                  data-price="{{ variant.price | money | escape }}"
                  data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                  data-available="{{ variant.available }}"
                  {% if variant.id == current_variant.id %}checked{% endif %}
                >
                <label
                  for="bb-variant-{{ section.id }}-{{ variant.id }}"
                  style="--bb-swatch: {{ swatch_color | strip }};"
                  {% unless variant.available %}class="is-sold-out"{% endunless %}
                >
                  <span class="bb-product__swatch" aria-hidden="true"></span>
                  <span>{{ variant.title | escape }}</span>
                  {%- unless variant.available -%}<span class="bb-product__sold-out">Sold out</span>{%- endunless -%}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-bb-variant data-image="{{ current_image | strip | escape }}" data-price="{{ current_variant.price | money | escape }}" data-compare-price="{% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money | escape }}{% endif %}" data-background="{{ current_background | strip | default: section.settings.background_color }}" data-panel="{{ current_panel | strip | default: section.settings.panel_color }}" data-available="{{ current_variant.available }}" data-variant-title="{{ current_variant.title | escape }}">
        {%- endif -%}

        <div class="bb-product__purchase">
          <input type="hidden" name="quantity" value="1">
          <button class="bb-product__add" type="submit" name="add" data-bb-add {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}Add to bag{%- else -%}Sold out{%- endif -%}
          </button>
          <button
            class="bb-product__buy-now"
            type="submit"
            name="add"
            formaction="{{ routes.cart_add_url }}?return_to=%2Fcheckout"
            data-bb-buy-now
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span>Buy now</span><span aria-hidden="true">→</span>
          </button>
        </div>
      {% endform %}

      <div class="bb-product__cart-error" data-bb-cart-error role="alert" hidden></div>

      <div class="bb-product__highlights" id="bb-product-features">
        <h2>It's all in the details</h2>
        <ul>
          {%- if product.metafields.custom.highlights.value != blank -%}
            {%- for highlight in product.metafields.custom.highlights.value -%}
              <li>{{ highlight | escape }}</li>
            {%- endfor -%}
          {%- else -%}
            {%- assign highlights = default_highlights | split: '|' -%}
            {%- for highlight in highlights -%}
              <li>{{ highlight | escape }}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
      <p class="bb-product__note">{{ section.settings.note | escape }}</p>
      <a class="bb-product__collection-link" href="{{ routes.root_url }}">Explore the collection <span aria-hidden="true">→</span></a>
    </div>
  </div>

  {%- if lifestyle_media_ids != ',' -%}
    <section class="bb-product__story" aria-labelledby="bb-product-story-title-{{ section.id }}">
      <div class="bb-product__story-media">
        {%- for media in product.media -%}
          {%- assign media_key = ',' | append: media.id | append: ',' -%}
          {%- if lifestyle_media_ids contains media_key -%}
            <button
              type="button"
              class="bb-product__extra-image bb-product__extra-image--photo"
              data-bb-zoom-src="{{ media | image_url: width: 1800 }}"
              data-bb-zoom-alt="{{ media.alt | escape }}"
              aria-label="View larger: {{ media.alt | default: product.title | escape }}"
            >
              {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 901px) 55vw, 100vw', alt: media.alt }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bb-product__story-copy">
        <p class="bb-product__eyebrow">STYLED BY YOU</p>
        <h2 id="bb-product-story-title-{{ section.id }}">Carry it <span>your way.</span></h2>
        <p>{{ product_headline | escape }} From everyday errands to weekends away, the {{ product.title | escape }} keeps up with every plan.</p>
        <a class="bb-product__story-link" href="#bb-product-colours">Choose your colour <span aria-hidden="true">↑</span></a>
      </div>
    </section>
  {%- endif -%}

  <dialog class="bb-product__cart-dialog" data-bb-cart-dialog aria-labelledby="bb-cart-dialog-title">
    <button type="button" class="bb-product__cart-dialog-close" data-bb-close-cart aria-label="Close">×</button>
    <p class="bb-product__eyebrow">A GOOD CHOICE</p>
    <h2 id="bb-cart-dialog-title" data-bb-cart-dialog-title>Added to your bag</h2>
    <div class="bb-product__cart-dialog-item">
      {%- if current_image != blank -%}
        <img src="{{ current_image | strip | escape }}" alt="" width="96" height="96" data-bb-cart-dialog-image>
      {%- endif -%}
      <div>
        <strong>{{ product.title | escape }}</strong>
        <span data-bb-cart-dialog-variant>{{ current_variant.title | escape }}</span>
        <span data-bb-cart-dialog-price>{{ current_variant.price | money }}</span>
      </div>
    </div>
    <p class="bb-product__cart-dialog-message" data-bb-cart-dialog-message>Your bag is ready whenever you are.</p>
    <a class="bb-product__cart-dialog-checkout" href="/checkout" data-bb-cart-dialog-checkout>Continue to checkout <span aria-hidden="true">→</span></a>
    <a class="bb-product__cart-dialog-view" href="{{ routes.cart_url }}">View your bag</a>
  </dialog>

  {%- comment -%} Two identical groups so the strip can loop without a gap. {%- endcomment -%}
  <div class="bb-product__ticker" aria-hidden="true">
    <div class="bb-product__ticker-track">
      {%- for group in (1..2) -%}
        <div class="bb-product__ticker-group">
          {%- for repeat in (1..3) -%}
            <span>CARRY. STYLE. REPEAT.</span><span class="bb-product__sparkle">✧</span>
            <span>YOUR EVERYDAY PLUS ONE.</span><span class="bb-product__sparkle">✧</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if detail_media_ids != ',' -%}
    <section class="bb-product__closer" aria-labelledby="bb-product-closer-title-{{ section.id }}">
      <div class="bb-product__closer-heading">
        <p class="bb-product__eyebrow">TAKE A CLOSER LOOK</p>
        <h2 id="bb-product-closer-title-{{ section.id }}">Inside <span>the details.</span></h2>
        <p>Every pocket, pouch and finishing touch, up close. Tap a photo to see it larger.</p>
      </div>
      <div class="bb-product__closer-grid">
        {%- for media in product.media -%}
          {%- assign media_key = ',' | append: media.id | append: ',' -%}
          {%- if detail_media_ids contains media_key -%}
            <figure class="bb-product__closer-item">
              <button
                type="button"
                class="bb-product__extra-image bb-product__extra-image--card"
                data-bb-zoom-src="{{ media | image_url: width: 1800 }}"
                data-bb-zoom-alt="{{ media.alt | escape }}"
                aria-label="View larger: {{ media.alt | default: product.title | escape }}"
              >
                {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 901px) 50vw, 100vw', alt: media.alt }}
              </button>
              {%- if media.alt != blank -%}
                <figcaption>{{ media.alt | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <section class="bb-product__faq">
    <div class="bb-product__faq-heading">
      <p class="bb-product__eyebrow">A FEW LITTLE DETAILS</p>
      <h2>Good to know.</h2>
      {%- if size_media_ids != ',' -%}
        {%- for media in product.media -%}
          {%- assign media_key = ',' | append: media.id | append: ',' -%}
          {%- if size_media_ids contains media_key -%}
            <figure class="bb-product__size">
              <button
                type="button"
                class="bb-product__extra-image bb-product__extra-image--card"
                data-bb-zoom-src="{{ media | image_url: width: 1800 }}"
                data-bb-zoom-alt="{{ media.alt | escape }}"
                aria-label="View larger: {{ media.alt | default: 'Size guide' | escape }}"
              >
                {{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 901px) 34vw, 100vw', alt: media.alt }}
              </button>
              <figcaption><strong>Size guide</strong>{% if media.alt != blank %} · {{ media.alt | escape }}{% endif %}</figcaption>
            </figure>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="bb-product__faq-list">
      <details>
        <summary>Which colours can I choose?</summary>
        <p>{{ product.title | escape }} comes in {% for variant in product.variants %}{{ variant.title | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}. Choose a colour above to see its matching product photo.</p>
      </details>
      <details>
        <summary>How do I know if a colour is available?</summary>
        <p>Availability and price are shown for each colour above. Sold-out colours can still be previewed, but cannot be added to your bag until they are back in stock.</p>
      </details>
      <details>
        <summary>Can I see the bag up close?</summary>
        <p>Tap the magnifier on the product photo, or any photo further down the page, to open a larger view. Pick a colour to see that bag in its matching shade.</p>
      </details>
    </div>
  </section>

  <section class="bb-product__related" id="bb-product-related">
    <div class="bb-product__related-heading">
      <p class="bb-product__eyebrow">MEET THE REST OF THE COLLECTION</p>
      <h2>Find your <span>next plus one.</span></h2>
    </div>
    <div class="bb-product__related-grid">
      {%- assign related_count = 0 -%}
      {%- for related_product in collections.all.products -%}
        {%- if related_product.id != product.id and related_count < 2 -%}
          {%- liquid
            assign related_variant = related_product.selected_or_first_available_variant | default: related_product.variants.first
            assign related_headline = related_product.metafields.custom.headline.value
            if related_headline == blank
              assign related_headline = related_product.description | strip_html | truncatewords: 8
            endif
            if related_headline == blank
              case related_product.handle
                when 'bow-tote'
                  assign related_headline = 'A little bow. A lot of personality.'
                when 'foldaway-tote'
                  assign related_headline = 'Big on the day. Small on the go.'
                when 'travel-weekender'
                  assign related_headline = 'Your next getaway starts here.'
              endcase
            endif
            capture related_image
              render 'bb-variant-image', product: related_product, variant: related_variant
            endcapture
          -%}
          <a class="bb-product__related-card" href="{{ related_product.url }}?variant={{ related_variant.id }}">
            <div class="bb-product__related-image">
              {%- if related_image != blank -%}
                <img
                  src="{{ related_image | strip | escape }}"
                  alt="{{ related_variant.title | escape }} / {{ related_product.title | escape }}"
                  width="700"
                  height="700"
                  loading="lazy"
                >
              {%- endif -%}
              <span aria-hidden="true">↗</span>
            </div>
            <h3>{{ related_product.title | escape }}</h3>
            <p>{{ related_product.variants.size }} colours{% if related_headline != blank %} / {{ related_headline | strip_html | escape }}{% endif %}</p>
          </a>
          {%- assign related_count = related_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <footer class="bb-product__footer">
    <a href="{{ routes.root_url }}" class="bb-product__footer-brand">{{ section.settings.brand_name | escape }}</a>
    <span>{{ section.settings.footer_tagline | escape }}</span>
    <a href="{{ routes.root_url }}">Back to collection <span aria-hidden="true">→</span></a>
  </footer>
</section>

{% schema %}
{
  "name": "Bag product details",
  "tag": "section",
  "class": "bb-product-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "BAG-IT"
    },
    {
      "type": "text",
      "id": "shipping_message",
      "label": "Shipping message",
      "default": "FREE INTERNATIONAL SHIPPING"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE CARRY COLLECTION"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Product background",
      "default": "#B8567C"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Image panel",
      "default": "#D980A2"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Secure checkout powered by Shopify."
    },
    {
      "type": "text",
      "id": "footer_tagline",
      "label": "Footer tagline",
      "default": "Everyday essentials. A little more personality."
    }
  ],
  "presets": [
    {
      "name": "Bag product details"
    }
  ]
}
{% endschema %}
