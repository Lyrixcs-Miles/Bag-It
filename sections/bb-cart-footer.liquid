<footer class="bb-cart-footer">
  <div class="bb-cart-footer__newsletter">
    <p class="bb-cart-footer__eyebrow">A LITTLE LOVE IN YOUR INBOX</p>
    <h2>{{ section.settings.newsletter_heading | escape }}</h2>
    {% form 'customer', id: 'bb-cart-newsletter', class: 'bb-cart-footer__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="bb-cart-email">{{ 'newsletter.label' | t }}</label>
      <input
        id="bb-cart-email"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="{{ 'newsletter.label' | t }}"
        required
      >
      <button type="submit" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
        <span aria-hidden="true">→</span>
      </button>
      {%- if form.errors -%}
        <small class="bb-cart-footer__message" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>
      {%- elsif form.posted_successfully? -%}
        <small class="bb-cart-footer__message" role="status">{{ 'newsletter.success' | t }}</small>
      {%- endif -%}
    {% endform %}
  </div>

  <div class="bb-cart-footer__bottom">
    <a class="bb-cart-footer__brand" href="{{ routes.root_url }}">{{ section.settings.brand_name | escape }}</a>
    <span class="bb-cart-footer__copyright">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | escape }}. Powered by Shopify.</span>
    <div class="bb-cart-footer__links">
      {%- if shop.policies.privacy_policy != blank -%}
        <a href="{{ shop.policies.privacy_policy.url }}">{{ shop.policies.privacy_policy.title | escape }}</a>
      {%- endif -%}
      {%- if shop.policies.refund_policy != blank -%}
        <a href="{{ shop.policies.refund_policy.url }}">{{ shop.policies.refund_policy.title | escape }}</a>
      {%- endif -%}
    </div>
    {%- if shop.enabled_payment_types != blank -%}
      <ul class="bb-cart-footer__payments list-unstyled" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Bag cart footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "BAG-IT"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "A little note from us."
    }
  ]
}
{% endschema %}
